public class ContaCorrente extends Conta implements Pagamento {

    private double limiteChequeEspecial;

    public ContaCorrente(String titular, double saldo, Status status, double limiteChequeEspecial) {
        super(titular, saldo, status);
        this.limiteChequeEspecial = limiteChequeEspecial;
    }

    @Override
    public void exibirTipoConta() {
        System.out.println("Conta Corrente");
    }

    @Override
    public boolean sacar(double valor) {
        double juros = valor * 0.02; 
        System.out.println("Aviso: Juros de R$ " + String.format("%.2f", juros) + " aplicados à transação.");
        return super.sacar(valor + juros);
    }

    @Override
    public void processarPagamento(double valor, String modalidade){

        
        if (modalidade.equalsIgnoreCase("Pix") && valor > 5000.0) {
            System.out.println("Falha: O limite máximo de pagamento do Pix é de R$ 5.000,00.");
            return;
        } else if (modalidade.equalsIgnoreCase("Cartão de Crédito") && valor > 20000.0) {
            System.out.println("Falha: O limite máximo de pagamento do Cartão é de R$ 20.000,00.");
            return;
        } else if (modalidade.equalsIgnoreCase("Boleto") && valor <= 0) {
            System.out.println("Falha: Para Boleto, o valor precisa ser maior que zero.");
            return;
        }

        if(sacar(valor)){
            System.out.println("Pagamento de R$ " + valor + " via " + modalidade + " concluído!");
        } else {
            System.out.println("O pagamento via " + modalidade + " falhou!");
        }
    }

    @Override
    public String toString() {
        return super.toString() + " | Tipo: Corrente | Limite: R$ " + String.format("%.2f", limiteChequeEspecial);
    }
}
